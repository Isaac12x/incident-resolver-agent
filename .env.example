# Required by the default hosted OpenAI model. Leave blank when using a local
# OpenAI-compatible endpoint that does not require authentication.
OPENAI_API_KEY=

# Optional. When set, incident webhook requests must include a matching HMAC
# signature. Strongly recommended whenever the HTTP service is publicly reachable.
AGENT_WEBHOOK_SECRET=

# Required only when receiving events through POST /hooks/github.
GITHUB_WEBHOOK_SECRET=

# Add any provider-specific variables named by model.api_key_env,
# model.organization_env, or connectors[].auth_token_env in .agent/config.toml.
# EXAMPLE_CONNECTOR_TOKEN=
