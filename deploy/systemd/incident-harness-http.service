[Unit]
Description=Incident Harness HTTP intake (webhooks only)
Documentation=file:///opt/incident-harness/README.md
After=network-online.target
Wants=network-online.target
PartOf=incident-harness.target
Conflicts=incident-harness.service
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=incident-harness
Group=incident-harness
WorkingDirectory=/opt/incident-harness

Environment=HOME=/var/lib/incident-harness
Environment=CODEX_HOME=/var/lib/incident-harness/.codex
Environment=PATH=/opt/incident-harness/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
RuntimeDirectory=incident-harness
ExecStartPre=/opt/incident-harness/.venv/bin/incident-agent export-systemd-env --output /run/incident-harness/environment
EnvironmentFile=-/run/incident-harness/environment
ExecStart=/opt/incident-harness/.venv/bin/incident-agent serve --no-worker
ExecStartPost=/opt/incident-harness/.venv/bin/incident-agent healthcheck --timeout 30

Restart=on-failure
RestartSec=5
KillMode=mixed
TimeoutStopSec=60

StateDirectory=incident-harness
StateDirectoryMode=0750
ReadWritePaths=/opt/incident-harness/.agent /var/lib/incident-harness
BindReadOnlyPaths=/etc/incident-harness
ReadWritePaths=/var/lib/incident-harness/.ssh

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=incident-harness.target
